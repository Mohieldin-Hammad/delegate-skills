#!/bin/sh
# spec-delegate:reference-transaction
#
# Refuses every ref change (commit, stash, reset, merge, rebase, branch, tag,
# fetch, checkout -b) in a delegate worktree. `worktree.mjs create` points that
# worktree's own core.hooksPath here, so it runs no matter what environment the
# implementer has, and `--no-verify` does not skip it. The main checkout and
# its hooks are untouched. The orchestrator lands with `worktree.mjs commit`
# and `worktree.mjs rebase`, which use the project's own hooks instead.
#
# It guards history, not files. Commands that discard working-tree changes
# without moving a ref (`git checkout -- <file>`, `git restore`, `git clean`,
# and the file half of `git reset --hard`) still run. Inside an implementer's
# worktree they can only reach that implementer's own uncommitted work.

[ "$1" = "prepared" ] || exit 0

echo "spec-delegate: ref changes are refused in a delegate worktree. Refused:" >&2
while read -r _old _new ref; do
  echo "  $ref" >&2
done
echo "Implementers: leave your changes in the working tree; the orchestrator reviews them." >&2
echo "Orchestrator: land with worktree.mjs commit or worktree.mjs rebase." >&2
exit 1
